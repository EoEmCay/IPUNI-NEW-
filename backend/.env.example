PORT=3001
JWT_SECRET=ipuni-secret-key-change-in-production
JWT_EXPIRES_IN=7d
NODE_ENV=development

# Gửi mail (khuyên dùng cho production): Resend, domain riêng, không phụ thuộc Gmail cá
# nhân dễ bị Google tự động chặn khi gửi tự động. Set RESEND_API_KEY thì mailer.js tự ưu
# tiên dùng Resend, bỏ qua MAIL_USER/MAIL_PASS bên dưới.
RESEND_API_KEY=re_your_resend_api_key
MAIL_FROM=DIA+ <no-reply@diaplus.vn>

# Fallback: Nodemailer qua Gmail SMTP (dùng App Password, không phải mật khẩu Gmail
# thường) - chỉ dùng khi chưa có RESEND_API_KEY, chủ yếu cho dev local.
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-app-password

# Google Gemini API Config (Khuyên dùng để đạt độ chính xác quét đơn thuốc cao nhất)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-flash-lite-latest

# Zalo ZNS qua eSMS - nhắc uống thuốc + báo người nhà qua Zalo (xem docs/ZALO_ZNS_TEMPLATES.md)
# Bỏ trống thì tính năng tự tắt. ESMS_API_KEY/ESMS_SECRET_KEY dùng chung với SMS OTP.
ESMS_API_KEY=
ESMS_SECRET_KEY=
ESMS_ZALO_OAID=
ZNS_TEMPLATE_DOSE_REMINDER=
ZNS_TEMPLATE_CAREGIVER_MISSED=
# 1 = gửi thử sandbox của eSMS (không tới người nhận thật)
ESMS_ZNS_SANDBOX=0

# Telegram bot - nhắc uống thuốc + báo người nhà (miễn phí). Tạo bot qua @BotFather trên Telegram.
# Bỏ trống thì tự tắt. Bot nhận tin bằng long polling: chỉ chạy 1 instance backend / 1 token.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# TrOCR đọc chữ viết tay (tuỳ chọn, cần Python venv - xem src/ai_ocr/README.md). Không bật trên Render hiện tại.
TROCR_ENABLED=0
# ensemble = TrOCR gợi ý cho Gemini | trocr = chỉ TrOCR (để đo)
SCAN_ENGINE=ensemble
